# Local dev uses a SQLite file. In production point this at Turso: libsql://<db>-<org>.turso.io
DATABASE_URL=file:local.db
# Only needed for Turso
DATABASE_AUTH_TOKEN=

# Random string used to sign session cookies. Required in production.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Optional. If set, people must enter this code to create an account.
INVITE_CODE=
